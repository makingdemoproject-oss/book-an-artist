# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Security ───────────────────────────────────────────────────
# JWT — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_ISSUER=book-an-artist
JWT_AUDIENCE=book-an-artist-api
BCRYPT_ROUNDS=10
# Comma-separated browser origins allowed by CORS (empty = no cross-origin browser access)
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind one reverse proxy / load balancer (so rate limiting sees real client IPs)
TRUST_PROXY=0
# Global rate limit per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ─── Server lifecycle ───────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# ─── MySQL — users, bookings, payments ──────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=book_an_artist
MYSQL_POOL_SIZE=10
# Integration tests use a separate database (defaults to <MYSQL_DATABASE>_test)
MYSQL_DATABASE_TEST=book_an_artist_test

# ─── MongoDB — artist profiles, reviews ─────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=book_an_artist
MONGO_POOL_SIZE=10

# Password for every seeded demo account (choose any value; local demo data only)
SEED_PASSWORD=
